diff --git a/target/linux/ath79/generic/base-files/etc/board.d/01_leds b/target/linux/ath79/generic/base-files/etc/board.d/01_leds
index 6409adb78..baeb39438 100644
--- a/target/linux/ath79/generic/base-files/etc/board.d/01_leds
+++ b/target/linux/ath79/generic/base-files/etc/board.d/01_leds
@@ -538,6 +538,15 @@ wd,mynet-wifi-rangeextender)
 	ucidef_set_led_rssi "rssimedium" "RSSIMED" "blue:rssi-med" "wlan0" "33" "100"
 	ucidef_set_led_rssi "rssihigh" "RSSIMAX" "blue:rssi-max" "wlan0" "66" "100"
 	;;
+xiaomi,mi-router-4-pro-r1350)
+	# blue:system (GPIO3) = led-running alias, handled by preinit — no ucidef needed
+	# yellow:system (GPIO2) = WAN link indicator
+	# blue:function (GPIO5) = 5GHz WiFi activity
+	# yellow:function (GPIO4) = 2.4GHz WiFi activity
+	ucidef_set_led_netdev "wan" "WAN" "yellow:system" "eth0" "link"
+	ucidef_set_led_wlan "wlan2g" "WLAN2G" "yellow:function" "phy0tpt"
+	ucidef_set_led_wlan "wlan5g" "WLAN5G" "blue:function" "phy1tpt"
+	;;
 xiaomi,aiot-ac2350)
 	ucidef_set_led_switch "wan" "WAN" "blue:wan" "switch0" "0x02"
 	;;
diff --git a/target/linux/ath79/generic/base-files/etc/board.d/02_network b/target/linux/ath79/generic/base-files/etc/board.d/02_network
